{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/products",
      "dest": "api/index.py"
    },
    {
      "src": "/borrowers",
      "dest": "api/index.py"
    },
    {
      "src": "/requisitions",
      "dest": "api/index.py"
    },
    {
      "src": "/returns",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
